{
  "manifest_version": 3,
  "name": "Trust Me Bru",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "description": "The price claim, the dated evidence, and a slow local price collector.",
  "permissions": [
    "storage",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://www.takealot.com/*",
    "https://www.incredible.co.za/*",
    "https://www.hificorp.co.za/*",
    "https://www.checkers.co.za/*",
    "https://www.hirschs.co.za/*",
    "https://www.pnp.co.za/*",
    "http://127.0.0.1:3210/*",
    "http://localhost:3210/*"
  ],
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Trust Me Bru"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.takealot.com/*",
        "https://www.incredible.co.za/*",
        "https://www.hificorp.co.za/*",
        "https://www.checkers.co.za/*",
        "https://www.hirschs.co.za/*",
        "https://www.pnp.co.za/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/mono.woff2"
      ],
      "matches": [
        "https://www.takealot.com/*",
        "https://www.incredible.co.za/*",
        "https://www.hificorp.co.za/*",
        "https://www.checkers.co.za/*",
        "https://www.hirschs.co.za/*",
        "https://www.pnp.co.za/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
